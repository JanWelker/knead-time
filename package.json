{
	"name": "knead-time",
	"version": "7.3.3",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "TZ=UTC vitest run",
		"test:watch": "TZ=UTC vitest",
		"test:coverage": "TZ=UTC vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:baseline": "svelte-kit sync && node scripts/check-test-baseline.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "svelte-kit sync || true; husky || true"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.20.5",
		"@vitest/coverage-v8": "5.0.3",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0",
		"vite": "8.3.2",
		"vitest": "5.0.3"
	},
	"lint-staged": {
		"*.{js,mjs,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,css,html}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource/anton": "^5.3.0",
		"qrcode-generator": "^2.0.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
